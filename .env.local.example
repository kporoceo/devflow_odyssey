# Copy this file to .env.local and fill in the real values from Supabase.
# Supabase Dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://owccxgcmcqkixqvahvxz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste_your_anon_public_key_here

# Server only (Manage Users). Supabase -> Project Settings -> API -> service_role key.
# Never add NEXT_PUBLIC_ to this name, and never share or commit the real key.
SUPABASE_SERVICE_ROLE_KEY=paste_your_service_role_key_here

# Server only, for the AI functions. From console.anthropic.com -> API Keys.
# Never put NEXT_PUBLIC_ in front of it.
ANTHROPIC_API_KEY=paste_your_anthropic_api_key_here
